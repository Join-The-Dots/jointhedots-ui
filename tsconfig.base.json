{
   "compilerOptions": {
      "target": "es2022",
      "lib": [
         "es2022",
         "dom",
         "dom.iterable"
      ],
      "module": "esnext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "strict": true,
      "noEmit": true,
      "skipLibCheck": true,
      "isolatedModules": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "types": [
         "vite/client"
      ],
      "noUncheckedIndexedAccess": true,
      "noImplicitOverride": true,
      "allowImportingTsExtensions": true
   }
}
